# ============================================
# SERVER CONFIGURATION
# ============================================
# Backend server port (default: 3050)
# Frontend Vite dev proxy expects this port
PORT=3050

# Server hostname (use 127.0.0.1 for local development)
HOST=127.0.0.1

# Fastify logger level (options: trace, debug, info, warn, error, fatal)
PLT_SERVER_LOGGER_LEVEL=info

# ============================================
# SECURITY
# ============================================
# JWT secret key for token signing
# IMPORTANT: Change this in production to a strong random string
JWT_SECRET=change_me_dev_only

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection details
#
# DB_USER is the dedicated application role, NOT the postgres superuser. The
# superuser is shared with another application on this machine, so a leaked or
# rotated superuser password breaks (or is reverted by) an unrelated product.
# Setup, once, as the postgres superuser:
#   CREATE ROLE surveypro_app LOGIN PASSWORD '...' NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   GRANT CONNECT, CREATE ON DATABASE surveypro_app TO surveypro_app;
# The role also has to own the existing schemas and their tables, because
# `npm run migrate` runs ALTER TABLE against objects that were created by
# postgres. See the "Database roles" section of CLAUDE.md.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surveypro_app
DB_USER=surveypro_app
DB_PASSWORD=CHANGE_ME

# Full database connection string
# IMPORTANT: Do not rely on nested ${VAR} expansion inside DATABASE_URL.
# Fill the full connection string manually after editing above values.
# The user here must match DB_USER above.
# Format: postgres://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgres://surveypro_app:CHANGE_ME@localhost:5432/surveypro_app

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. Copy this file to .env and update values
# 2. Never commit .env to version control
# 3. Generate strong JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 4. Ensure PostgreSQL database exists before starting server

# ── VunGIS: jobs opened from the council system (docs/AUTHORITY_TENANCY.md) ──────────────
# VunGIS signs a launch token with a private key; SurveyPro checks it with VunGIS's PUBLIC key. Get it from VunGIS
# (node scripts/generate-launch-keys.js there). Unset = POST /api/auth/launch answers 503.
# VUNGIS_LAUNCH_PUBLIC_KEY=   (PEM, newlines as \n)
# VUNGIS_LAUNCH_KEY_FILE=     (or a file holding it)
# VUNGIS_LAUNCH_ISSUER=vungis

# Where survey data lives. schema (default): each surveyor's own schema. shared: the shared survey.* tables, as the signed-in person (migration 103; run scripts/cutover-to-shared.js first).
# SURVEY_STORE=schema

# Register check (asks VunGIS whether a layout would be accepted): the key SurveyPro signs with (node scripts/generate-service-keys.js) and where VunGIS is.
# SURVEYPRO_SERVICE_KEY_FILE=.service-key.pem
# VUNGIS_API_URL=http://localhost:3000
