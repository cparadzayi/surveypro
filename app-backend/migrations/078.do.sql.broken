-- Migration 078: Historical Survey Points for Beacon Comparison
-- Used by Found Beacons Assessment module to compare current survey with previous surveys
-- Comparison uses SI 727 of 1979 tolerances

-- Create historical_survey_points table
CREATE TABLE IF NOT EXISTS historical_survey_points (
  id SERIAL PRIMARY KEY,
  project_id INTEGER NOT NULL REFERENCES survey_projects(id) ON DELETE CASCADE,
  
  -- Point identification
  point_name VARCHAR(50) NOT NULL,
  
  -- Cape Lo coordinates (as stored in original survey records)
  y_coordinate DECIMAL(12, 4) NOT NULL,  -- Westing
  x_coordinate DECIMAL(12, 4) NOT NULL,  -- Southing
  
  -- Survey record reference
  sr_number VARCHAR(50),  -- e.g., "200/2000"
  
  -- Beacon description
  description VARCHAR(255),  -- e.g., "50mm Iron"
  
  -- Original survey date
  survey_date VARCHAR(50),  -- Stored as text to handle various formats like "November-00"
  
  -- Coordinate system and measurement unit (crucial for comparison)
  coordinate_system VARCHAR(50),  -- e.g., "Lo 31", "Lo 29", "WGS84"
  measurement_unit VARCHAR(10) DEFAULT 'M',  -- e.g., "M" for meters, "FT" for feet
  
  -- Import tracking
  import_id INTEGER REFERENCES project_csv_imports(id) ON DELETE SET NULL,
  imported_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  -- Metadata for additional fields
  metadata JSONB DEFAULT '{}',
  
  -- Timestamps
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  
  -- Ensure unique point names per project
  CONSTRAINT unique_historical_point_per_project UNIQUE (project_id, point_name, sr_number)
);

-- Create index for efficient lookups
CREATE INDEX IF NOT EXISTS idx_historical_survey_points_project 
  ON historical_survey_points(project_id);

CREATE INDEX IF NOT EXISTS idx_historical_survey_points_name 
  ON historical_survey_points(point_name);

CREATE INDEX IF NOT EXISTS idx_historical_survey_points_sr_number 
  ON historical_survey_points(sr_number);

-- Add comment
COMMENT ON TABLE historical_survey_points IS 
  'Stores historical survey point data for beacon comparison. Used by Found Beacons Assessment module with SI 727 of 1979 tolerances.';

COMMENT ON COLUMN historical_survey_points.y_coordinate IS 'Cape Lo Y coordinate (Westing)';
COMMENT ON COLUMN historical_survey_points.x_coordinate IS 'Cape Lo X coordinate (Southing)';
COMMENT ON COLUMN historical_survey_points.sr_number IS 'Survey Record number reference (e.g., 200/2000)';
COMMENT ON COLUMN historical_survey_points.coordinate_system IS 'Coordinate system used (e.g., Lo 31, Lo 29, WGS84) - crucial for comparison';
COMMENT ON COLUMN historical_survey_points.measurement_unit IS 'Measurement unit (M=meters, FT=feet)';

-- Create view for beacon comparison analysis
CREATE OR REPLACE VIEW v_beacon_comparison AS
SELECT 
  h.id AS historical_id,
  h.project_id,
  h.point_name AS historical_point_name,
  h.y_coordinate AS historical_y,
  h.x_coordinate AS historical_x,
  h.sr_number,
  h.description AS historical_description,
  h.survey_date AS historical_survey_date,
  h.coordinate_system AS historical_coord_system,
  h.measurement_unit AS historical_meas_unit,
  cp.id AS current_point_id,
  cp.name AS current_point_name,
  cp.y AS current_y,
  cp.x AS current_x,
  cp.description AS current_description,
  -- Calculate coordinate differences
  CASE WHEN cp.id IS NOT NULL THEN 
    ABS(h.y_coordinate - cp.y)
  END AS y_difference,
  CASE WHEN cp.id IS NOT NULL THEN 
    ABS(h.x_coordinate - cp.x)
  END AS x_difference,
  -- Calculate linear distance between points
  CASE WHEN cp.id IS NOT NULL THEN 
    SQRT(POWER(h.y_coordinate - cp.y, 2) + POWER(h.x_coordinate - cp.x, 2))
  END AS linear_distance,
  -- SI 727 tolerance check (0.05m for urban, 0.10m for rural)
  CASE 
    WHEN cp.id IS NULL THEN 'NOT_MATCHED'
    WHEN SQRT(POWER(h.y_coordinate - cp.y, 2) + POWER(h.x_coordinate - cp.x, 2)) <= 0.05 THEN 'WITHIN_URBAN_TOLERANCE'
    WHEN SQRT(POWER(h.y_coordinate - cp.y, 2) + POWER(h.x_coordinate - cp.x, 2)) <= 0.10 THEN 'WITHIN_RURAL_TOLERANCE'
    ELSE 'EXCEEDS_TOLERANCE'
  END AS tolerance_status
FROM historical_survey_points h
LEFT JOIN coordinate_points cp ON 
  cp.project_id = h.project_id AND 
  (
    cp.name = h.point_name OR
    cp.name ILIKE h.point_name || '%' OR
    h.point_name ILIKE cp.name || '%'
  );

COMMENT ON VIEW v_beacon_comparison IS 
  'Compares historical survey points with current coordinate points for SI 727 beacon assessment';

-- Update trigger for updated_at
CREATE OR REPLACE FUNCTION update_historical_survey_points_timestamp()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trigger_historical_survey_points_updated ON historical_survey_points;
CREATE TRIGGER trigger_historical_survey_points_updated
  BEFORE UPDATE ON historical_survey_points
  FOR EACH ROW
  EXECUTE FUNCTION update_historical_survey_points_timestamp();
