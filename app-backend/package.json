{
  "name": "surveypro-backend",
  "version": "0.1.0",
  "description": "SurveyPro Backend (Fastify + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "migrate": "node scripts/migrate.js",
    "setup:schemas": "node scripts/setup-surveyor-schemas.js",
    "setup:auto": "node scripts/auto-setup.js",
    "seed:sample": "node scripts/seed-sample-points.mjs",
    "fix:projects": "node scripts/fix-project-linkage.js",
    "fix:charles": "node scripts/fix-charles-projects.js",
    "convert:wgs84": "psql -h localhost -U postgres -d surveypro_v1 -f scripts/populate-wgs84-all-zones.sql",
    "convert:wgs84:correct": "psql -h localhost -U postgres -d surveypro_v1 -f scripts/populate-wgs84-cape-datum-correct.sql",
    "check:projects": "psql -h localhost -U postgres -d surveypro_v1 -f scripts/check-projects.sql",
    "fix:orphaned": "psql -h localhost -U postgres -d surveypro_v1 -f scripts/fix-orphaned-projects.sql",
    "check:user": "psql -h localhost -U postgres -d surveypro_v1 -f scripts/check-user-profile.sql",
    "check:details": "psql -h localhost -U postgres -d surveypro_v1 -f scripts/check-project-details.sql",
    "check:wgs84": "psql -h localhost -U postgres -d surveypro_v1 -f scripts/check-wgs84-sample.sql"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.2.1",
    "bcrypt": "^5.1.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "nodemon": "^3.1.14",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "proj4": "^2.20.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0"
  }
}
