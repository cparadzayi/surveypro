{
  "$schema": "https://schemas.platformatic.dev/@platformatic/db/2.21.1.json",
  "server": {
    "hostname": "{PLT_SERVER_HOSTNAME}",
    "port": "{PORT}",
    "logger": { "level": "{PLT_SERVER_LOGGER_LEVEL}" },
    "cors": { "origin": true, "credentials": true }
  },
  "db": {
    "connectionString": "{DATABASE_URL}",
    "openapi": true,
    "graphql": true,
    "ignore": { 
      "versions": true
    },
    "onDatabaseError": "return"
  },
  "migrations": { "dir": "migrations", "autoApply": true },
  "plugins": { "paths": ["./plugins/auth.mjs", "./plugins/health.mjs", "./plugins/spatial.mjs"] }
}
