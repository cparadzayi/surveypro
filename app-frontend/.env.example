# ============================================
# SURVEYPRO FRONTEND ENVIRONMENT
# ============================================
# Copy this file to .env and adjust as needed
# Note: Changes to .env require restarting the dev server

# ============================================
# API CONFIGURATION
# ============================================
# Base URL for backend API requests
#
# DEVELOPMENT MODE (recommended):
# Use relative path to leverage Vite's dev proxy (configured in vite.config.ts)
# The proxy automatically forwards /api/* requests to http://127.0.0.1:3050
# This avoids CORS issues during development
VITE_API_BASE=/api

# PRODUCTION MODE:
# Use full backend URL including /api path
# Example: VITE_API_BASE=https://api.yourdomain.com/api
# Or: VITE_API_BASE=http://your-server-ip:3050/api

# ============================================
# DEPLOYMENT NOTES
# ============================================
# Development:
#   1. Keep VITE_API_BASE=/api (uses Vite proxy)
#   2. Ensure backend is running on http://127.0.0.1:3050
#   3. Run: npm run dev
#
# Production Build:
#   1. Set VITE_API_BASE to your backend URL with /api path
#   2. Build: npm run build
#   3. Deploy dist/ folder to your web server
#
# Testing Production Build Locally:
#   1. Set VITE_API_BASE=http://localhost:3050/api
#   2. Build: npm run build
#   3. Preview: npm run preview
