#############################################
# SurveyPro Backend Environment (Template)  #
#############################################

# Server
PORT=3042
PLT_SERVER_HOSTNAME=127.0.0.1
PLT_SERVER_LOGGER_LEVEL=info
NODE_ENV=development
PLT_WATCH_ENABLED=true

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surveypro
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_SECURELY
# Compose full URL at runtime OR uncomment and replace placeholders:
# DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# CORS (tighten in production)
CORS_ORIGIN=*

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Auth currently disabled (MVP). Uncomment when reintroducing:
# JWT_SECRET=
# PLT_ADMIN_SECRET=

# Instructions:
# 1. Copy to .env (never commit .env)
# 2. Set DB_PASSWORD via secret manager or export before start if possible
# 3. If using Docker/K8s, inject DB_* and construct DATABASE_URL in entrypoint
